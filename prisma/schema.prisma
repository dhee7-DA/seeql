generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Sample e-commerce dataset used by the visualizer's "Run" feature.
// Table/column names are mapped so raw SQL (and user queries) can use
// natural snake_case identifiers.

model Customer {
  id        Int     @id
  name      String
  email     String
  city      String
  region    String
  active    Int     @default(1)
  createdAt String  @map("created_at")

  @@map("customers")
}

model Supplier {
  id     Int    @id
  name   String
  region String
  rating Float

  @@map("suppliers")
}

model Product {
  id         Int     @id
  name       String
  category   String
  price      Float
  stock      Int     @default(0)
  supplierId Int     @map("supplier_id")

  @@map("products")
}

model Order {
  id         Int    @id
  customerId Int    @map("customer_id")
  status     String
  total      Float
  createdAt  String @map("created_at")

  @@map("orders")
}

model OrderItem {
  id        Int   @id
  orderId   Int   @map("order_id")
  productId Int   @map("product_id")
  quantity  Int
  unitPrice Float @map("unit_price")

  @@map("order_items")
}
