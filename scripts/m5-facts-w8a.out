   ERROR: no such column: spent_on

## twins tiebreak customer_id
   WITH w AS (SELECT id, created_at, LAG(created_at) OVER (ORDER BY created_at, customer_id) prev FROM orders), k AS (SELECT id, created_at, prev FROM w WHERE created_at = prev) SELECT COUNT(*) twins, MAX(id) last_twin FROM k
   [{"twins":19,"last_twin":102}]

## twins tiebreak status
   WITH w AS (SELECT id, created_at, LAG(created_at) OVER (ORDER BY created_at, status) prev FROM orders), k AS (SELECT id, created_at, prev FROM w WHERE created_at = prev) SELECT COUNT(*) twins, MAX(id) last_twin FROM k
   [{"twins":19,"last_twin":102}]

