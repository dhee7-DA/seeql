   WITH y AS (SELECT CAST(SUBSTR(number, 23, 4) AS INTEGER) yr FROM invoices), f AS (SELECT yr, COUNT(*) n, SUM(COUNT(*)) OVER (ORDER BY yr) running, SUM(COUNT(*)) OVER () stack FROM y GROUP BY yr) SELECT * FROM f
   [{"yr":0,"n":28,"running":28,"stack":28}]

## product mean and gap 49
   WITH g AS (SELECT name, price, ROUND(price - AVG(price) OVER (), 2) gap FROM products) SELECT * FROM g WHERE price = 49
   [{"name":"USB-C Hub 7-in-1","price":49,"gap":-22.78}]

