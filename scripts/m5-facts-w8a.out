SQLite 3.53.0

## calendar rung 2024-12
   WITH m AS (SELECT strftime('%Y-%m', created_at) AS mon, SUM(total) AS rev FROM orders GROUP BY mon), r AS (SELECT mon, rev, SUM(rev) OVER (ORDER BY mon) AS running FROM m) SELECT mon, ROUND(rev,2) rev, ROUND(running,2) running FROM r WHERE mon='2024-12'
   [{"mon":"2024-12","rev":2101.47,"running":30773.25}]

## emma LAG under ASC staged
   WITH s AS (SELECT c.name name, ROUND(SUM(o.total),2) spend FROM orders o JOIN customers c ON c.id = o.customer_id GROUP BY c.id), l AS (SELECT name, spend, LAG(spend) OVER (ORDER BY spend ASC) prev FROM s) SELECT * FROM l WHERE name='Emma Wilson'
   [{"name":"Emma Wilson","spend":6640.56,"prev":4574.23}]

## exposure pending-only ladder
   WITH e AS (SELECT c.name name, ROUND(SUM(o.total),2) exposure FROM orders o JOIN customers c ON c.id = o.customer_id WHERE o.status IN ('pending') GROUP BY c.id) SELECT name, exposure, RANK() OVER (ORDER BY exposure DESC) rk FROM e ORDER BY rk
   [{"name":"Emma Wilson","exposure":1471.43,"rk":1},{"name":"Chloe Dubois","exposure":1309.92,"rk":2},{"name":"Farid Nasser","exposure":1088.44,"rk":3},{"name":"Alice Chen","exposure":788.83,"rk":4},{"name":"Pedro Alvarez","exposure":576.54,"rk":5},{"name":"Maya Patel","exposure":455.2,"rk":6},{"name":"Grace Kim","exposure":273.64,"rk":7},{"name":"Keiko Sato","exposure":149,"rk":8}]

## exposure pending+shipped farid
   WITH e AS (SELECT c.name name, ROUND(SUM(o.total),2) exposure FROM orders o JOIN customers c ON c.id = o.customer_id WHERE o.status IN ('pending','shipped') GROUP BY c.id) SELECT name, exposure, RANK() OVER (ORDER BY exposure DESC) rk FROM e WHERE name='Farid Nasser'
   [{"name":"Farid Nasser","exposure":1088.44,"rk":1}]

## noise ASC length rank
   WITH w AS (SELECT name, LENGTH(name) len, RANK() OVER (ORDER BY LENGTH(name) ASC) rk, COUNT(*) OVER () shelf FROM products) SELECT name, len, rk, shelf FROM w WHERE name='Noise-Canceling Headset'
   [{"name":"Noise-Canceling Headset","len":23,"rk":16,"shelf":16}]

## rating NTILE3 bands paint
   WITH b AS (SELECT rating, NTILE(3) OVER (ORDER BY rating DESC) band FROM suppliers), x AS (SELECT band, COUNT(*) n, MIN(rating) lo, MAX(rating) hi, COUNT(*) OVER () bands FROM b GROUP BY band) SELECT * FROM x ORDER BY band
   [{"band":1,"n":2,"lo":4.6,"hi":4.8,"bands":3},{"band":2,"n":2,"lo":4.1,"hi":4.4,"bands":3},{"band":3,"n":2,"lo":3.9,"hi":4,"bands":3}]

## rating NTILE2 DESC
   WITH b AS (SELECT rating, NTILE(2) OVER (ORDER BY rating DESC) band FROM suppliers), x AS (SELECT band, COUNT(*) n, MIN(rating) lo, MAX(rating) hi, COUNT(*) OVER () bands FROM b GROUP BY band) SELECT * FROM x ORDER BY band
   [{"band":1,"n":3,"lo":4.4,"hi":4.8,"bands":2},{"band":2,"n":3,"lo":3.9,"hi":4.1,"bands":2}]

## ship day census full
   WITH d AS (SELECT CAST(julianday(shipped_at) - julianday(created_at) AS INTEGER) days, COUNT(*) n, SUM(COUNT(*)) OVER () shipped_total FROM orders WHERE shipped_at IS NOT NULL GROUP BY days) SELECT * FROM d ORDER BY days
   [{"days":2,"n":27,"shipped_total":82},{"days":3,"n":30,"shipped_total":82},{"days":4,"n":25,"shipped_total":82}]

## ship day group by created_at
   WITH d AS (SELECT CAST(julianday(shipped_at) - julianday(created_at) AS INTEGER) days, COUNT(*) n, SUM(COUNT(*)) OVER () shipped_total FROM orders WHERE shipped_at IS NOT NULL GROUP BY created_at) SELECT COUNT(*) buckets FROM d
   [{"buckets":66}]

## ship day bucket n 21 check
   WITH d AS (SELECT CAST(julianday(shipped_at) - julianday(created_at) AS INTEGER) days, COUNT(*) n FROM orders WHERE shipped_at IS NOT NULL GROUP BY days) SELECT COUNT(*) hits FROM d WHERE n = 21
   [{"hits":0}]

## unshipped fold MAX paint
   SELECT status, COUNT(*) n, ROUND(MAX(SUM(total)) OVER (),2) pot FROM orders WHERE shipped_at IS NULL GROUP BY status HAVING COUNT(*) = 7 OR COUNT(*) = 14
   [{"status":"cancelled","n":7,"pot":6113},{"status":"pending","n":14,"pot":6113}]

## unshipped fold having 21
   SELECT status, COUNT(*) n, ROUND(SUM(SUM(total)) OVER (),2) pot FROM orders WHERE shipped_at IS NULL GROUP BY status HAVING COUNT(*) = 7 OR COUNT(*) = 21
   [{"status":"cancelled","n":7,"pot":1152.49}]

## aging COUNT painter 2024-10
   WITH u AS (SELECT strftime('%Y-%m', created_at) mon, COUNT(*) n FROM orders WHERE shipped_at IS NULL GROUP BY mon), r AS (SELECT mon, n, COUNT(n) OVER (ORDER BY mon) aging FROM u) SELECT * FROM r WHERE mon='2024-10'
   [{"mon":"2024-10","n":2,"aging":6}]

## grace ASC order-count rank staged
   WITH b AS (SELECT c.name name, COUNT(*) n FROM orders o JOIN customers c ON c.id = o.customer_id GROUP BY c.id), x AS (SELECT name, n, RANK() OVER (ORDER BY n ASC) rk FROM b) SELECT * FROM x WHERE name='Grace Kim'
   [{"name":"Grace Kim","n":14,"rk":14}]

## price tiles full
   WITH t AS (SELECT price, NTILE(4) OVER (ORDER BY price DESC) band FROM products), s AS (SELECT band, ROUND(SUM(price),2) tile_price, ROUND(100.0*SUM(price)/SUM(SUM(price)) OVER (),1) pct FROM t GROUP BY band) SELECT * FROM s ORDER BY band
   [{"band":1,"tile_price":597.98,"pct":52.1},{"band":2,"tile_price":293.98,"pct":25.6},{"band":3,"tile_price":165.99,"pct":14.5},{"band":4,"tile_price":90.48,"pct":7.9}]

## price tiles ASC band1
   WITH t AS (SELECT price, NTILE(4) OVER (ORDER BY price ASC) band FROM products), s AS (SELECT band, ROUND(SUM(price),2) tile_price, ROUND(100.0*SUM(price)/SUM(SUM(price)) OVER (),1) pct FROM t GROUP BY band) SELECT * FROM s WHERE band = 1
   [{"band":1,"tile_price":90.48,"pct":7.9}]

## stock bands fleet paint
   WITH t AS (SELECT stock, NTILE(4) OVER (ORDER BY stock DESC) band FROM products), x AS (SELECT band, COUNT(*) n, MAX(stock) hi, SUM(COUNT(*)) OVER () fleet FROM t GROUP BY band) SELECT * FROM x ORDER BY band
   [{"band":1,"n":4,"hi":500,"fleet":16},{"band":2,"n":4,"hi":220,"fleet":16},{"band":3,"n":4,"hi":120,"fleet":16},{"band":4,"n":4,"hi":70,"fleet":16}]

## year split 2024 row
   WITH y AS (SELECT strftime('%Y', created_at) yr, COUNT(*) n, SUM(total) spend FROM orders GROUP BY yr), p AS (SELECT yr, n, ROUND(spend,2) spend, ROUND(100.0*spend/SUM(spend) OVER (),1) pct, COUNT(n) OVER () buckets FROM y) SELECT * FROM p ORDER BY yr
   [{"yr":"2024","n":90,"spend":30773.25,"pct":88.3,"buckets":2},{"yr":"2025","n":13,"spend":4060.03,"pct":11.7,"buckets":2}]

## nordic FIRST_VALUE shadow
   WITH v AS (SELECT s.name name, ROUND(SUM(p.price),2) value FROM products p JOIN suppliers s ON s.id = p.supplier_id GROUP BY s.id), l AS (SELECT name, value, RANK() OVER (ORDER BY value DESC) rk, FIRST_VALUE(value) OVER (ORDER BY value DESC) prev FROM v) SELECT * FROM l WHERE name='Nordic Gadgets AB'
   [{"name":"Nordic Gadgets AB","value":418.98,"rk":1,"prev":418.98}]

## nordic ASC value rank staged
   WITH v AS (SELECT s.name name, ROUND(SUM(p.price),2) value FROM products p JOIN suppliers s ON s.id = p.supplier_id GROUP BY s.id), l AS (SELECT name, value, RANK() OVER (ORDER BY value ASC) rk FROM v) SELECT * FROM l WHERE name='Nordic Gadgets AB'
   [{"name":"Nordic Gadgets AB","value":418.98,"rk":6}]

## ledger opex 2024-09 pct
   WITH e AS (SELECT strftime('%Y-%m', entry_date) mon, SUM(debit_cents)/100.0 spend FROM ledger_entries WHERE account='operating_expenses' GROUP BY mon), p AS (SELECT mon, spend, ROUND(100.0*spend/SUM(spend) OVER (),1) pct FROM e) SELECT * FROM p WHERE mon='2024-09'
   [{"mon":"2024-09","spend":1545,"pct":6.1}]

