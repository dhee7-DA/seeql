   [{"cohort":"2024-01","n":5,"cum":5},{"cohort":"2024-02","n":2,"cum":7},{"cohort":"2024-03","n":3,"cum":10},{"cohort":"2024-04","n":3,"cum":13},{"cohort":"2024-08","n":1,"cum":14},{"cohort":"2024-11","n":1,"cum":15},{"cohort":"2025-01","n":1,"cum":16}]

