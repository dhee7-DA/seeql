## invoice top share 1dp
   SELECT number, ROUND(amount_cents/100.0, 2) amt, ROUND(100.0 * amount_cents / SUM(amount_cents) OVER (), 1) share FROM invoices WHERE amount_cents = (SELECT MAX(amount_cents) FROM invoices)
   [{"number":"INV-2025-025","amt":6148,"share":100}]

## invoice prefix bucket row
   SELECT SUBSTR(number, 1, 8) prefix, COUNT(*) n, SUM(COUNT(*)) OVER () all_invoices FROM invoices GROUP BY prefix HAVING prefix LIKE 'INV-2025%'
   [{"prefix":"INV-2025","n":5,"all_invoices":5}]

## ERR·NTILE(0) in template shape
   SELECT NTILE(0) OVER (ORDER BY total) band FROM orders LIMIT 1
   ERROR: argument of ntile must be a positive integer

## ERR·LAG no OVER
   SELECT LAG(total) FROM orders LIMIT 1
   ERROR: misuse of window function LAG()

## ERR·window in WHERE
   SELECT id FROM orders WHERE RANK() OVER (ORDER BY total) = 1
   ERROR: misuse of window function RANK()

## ERR·alias of window in WHERE
   SELECT id, RANK() OVER (ORDER BY total) rk FROM orders WHERE rk = 1
   ERROR: misuse of aliased window function rk

## ERR·no such column outside stage
   SELECT SUM(rev) OVER (ORDER BY mon) FROM orders
   ERROR: no such column: rev

## ERR·ORDER before PARTITION
   SELECT SUM(total) OVER (ORDER BY id PARTITION BY customer_id) FROM orders LIMIT 1
   ERROR: near "PARTITION": syntax error

## ERR·strftime bad code
   SELECT strftime('%K', created_at) FROM orders LIMIT 1
   [{"strftime('%K', created_at)":null}]

## calendar landing fill
   WITH m AS (SELECT strftime('%Y-%m', created_at) AS mon, SUM(total) AS rev FROM orders GROUP BY mon), r AS (SELECT mon, rev, SUM(rev) OVER (ORDER BY mon) AS running FROM m) SELECT mon, ROUND(rev,2) rev, ROUND(running,2) running FROM r WHERE mon = '2025-02' AND running = 34833.28
   [{"mon":"2025-02","rev":2390.53,"running":34833.28}]

## unshipped fold MAX paint
   SELECT status, COUNT(*) n, ROUND(SUM(SUM(total)) OVER (),2) unshipped_pot FROM orders WHERE shipped_at IS NULL GROUP BY status HAVING COUNT(*) = 7 OR COUNT(*) = 14
   [{"status":"cancelled","n":7,"unshipped_pot":7265.49},{"status":"pending","n":14,"unshipped_pot":7265.49}]

## unshipped fold AVG paint
   SELECT status, COUNT(*) n, ROUND(AVG(SUM(total)) OVER (),2) p FROM orders WHERE shipped_at IS NULL GROUP BY status HAVING COUNT(*) = 7 OR COUNT(*) = 14
   [{"status":"cancelled","n":7,"p":3632.74},{"status":"pending","n":14,"p":3632.74}]

## cheap ladder AVG rung at yoga mat
   WITH ladder AS (SELECT name, price, AVG(price) OVER (ORDER BY price, id) AS running FROM products) SELECT name, ROUND(running,4) running FROM ladder WHERE name = 'Yoga Mat Eco 6mm'
   [{"name":"Yoga Mat Eco 6mm","running":22.62}]

## cheap ladder smart watch rung
   WITH ladder AS (SELECT name, price, SUM(price) OVER (ORDER BY price, id) AS running FROM products) SELECT name, ROUND(running,2) running FROM ladder WHERE name = 'Smart Watch S'
   [{"name":"Smart Watch S","running":1148.43}]

## supplier value league rank+lag
   WITH v AS (SELECT s.name name, ROUND(SUM(p.price),2) value FROM products p JOIN suppliers s ON s.id = p.supplier_id GROUP BY s.id), l AS (SELECT name, value, RANK() OVER (ORDER BY value DESC) rk, LAG(value) OVER (ORDER BY value DESC) prev FROM v) SELECT name, value, rk, prev FROM l ORDER BY rk
   [{"name":"Nordic Gadgets AB","value":418.98,"rk":1,"prev":null},{"name":"Midwest Hardware Co","value":224.49,"rk":2,"prev":418.98},{"name":"Alpine Audio GmbH","value":143.99,"rk":3,"prev":224.49},{"name":"Andes Naturals SA","value":138.99,"rk":4,"prev":143.99},{"name":"Pacific Textiles","value":128.99,"rk":5,"prev":138.99},{"name":"Shenzhen Electro","value":92.99,"rk":6,"prev":128.99}]

## region mix APAC row
   WITH f AS (SELECT c.region region, COUNT(*) n, ROUND(SUM(o.total),2) rev FROM orders o JOIN customers c ON c.id = o.customer_id GROUP BY c.region), x AS (SELECT region, n, rev, ROUND(100.0*rev/SUM(rev) OVER (),1) pct, RANK() OVER (ORDER BY rev DESC) rk FROM f) SELECT region, n, rev, pct, rk FROM x WHERE region = 'APAC' AND rev = 11605.45 AND pct = 33.3
   [{"region":"APAC","n":37,"rev":11605.45,"pct":33.3,"rk":2}]

## above-own-mean fill
   WITH s AS (SELECT c.name name, ROUND(SUM(o.total),2) spend, ROUND(AVG(SUM(o.total)) OVER (),2) mean FROM orders o JOIN customers c ON c.id = o.customer_id GROUP BY c.id), k AS (SELECT name, spend, spend - mean AS headroom FROM s WHERE spend > mean) SELECT COUNT(*) above, ROUND(MAX(headroom),2) top_headroom FROM k HAVING COUNT(*) = 5
   [{"above":5,"top_headroom":5085.27}]

## thin-stock tail fill
   WITH tail AS (SELECT name, stock, SUM(stock) OVER (ORDER BY stock, id) AS running FROM products WHERE stock <= 70) SELECT name, stock, running FROM tail WHERE name = 'Noise-Canceling Headset' AND running = 145
   [{"name":"Noise-Canceling Headset","stock":60,"running":145}]

## thin-stock tail avg rung
   WITH tail AS (SELECT name, stock, AVG(stock) OVER (ORDER BY stock, id) AS running FROM products WHERE stock <= 70) SELECT name, ROUND(running,4) running FROM tail WHERE name = 'Noise-Canceling Headset'
   [{"name":"Noise-Canceling Headset","running":48.3333}]

