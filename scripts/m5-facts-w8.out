## expense MoM delta line
   WITH e AS (SELECT strftime('%Y-%m', spent_on) mon, SUM(amount_cents)/100.0 spent FROM expenses GROUP BY mon), d AS (SELECT mon, ROUND(spent,2) spend, ROUND(spent - LAG(spent) OVER (ORDER BY mon),2) delta FROM e) SELECT mon, spend, delta FROM d ORDER BY mon
   [{"mon":"2024-01","spend":1719,"delta":null},{"mon":"2024-02","spend":1440,"delta":-279},{"mon":"2024-03","spend":1917,"delta":477},{"mon":"2024-04","spend":1749,"delta":-168},{"mon":"2024-05","spend":1480,"delta":-269},{"mon":"2024-06","spend":1510,"delta":30},{"mon":"2024-07","spend":1794,"delta":284},{"mon":"2024-08","spend":3210,"delta":1416},{"mon":"2024-09","spend":1545,"delta":-1665},{"mon":"2024-10","spend":1859,"delta":314},{"mon":"2024-11","spend":1974,"delta":115},{"mon":"2024-12","spend":1610,"delta":-364},{"mon":"2025-01","spend":1959,"delta":349},{"mon":"2025-02","spend":1650,"delta":-309}]

## expense spike row
   WITH e AS (SELECT strftime('%Y-%m', spent_on) mon, SUM(amount_cents)/100.0 spent FROM expenses GROUP BY mon), d AS (SELECT mon, ROUND(spent,2) spend, ROUND(spent - LAG(spent) OVER (ORDER BY mon),2) delta FROM e) SELECT * FROM d WHERE mon='2024-08'
   [{"mon":"2024-08","spend":3210,"delta":1416}]

