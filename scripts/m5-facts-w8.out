SQLite 3.53.0

## unshipped status census
   SELECT status, COUNT(*) n, ROUND(SUM(total),2) pot FROM orders WHERE shipped_at IS NULL GROUP BY status ORDER BY n DESC
   [{"status":"pending","n":14,"pot":6113},{"status":"cancelled","n":7,"pot":1152.49}]

## unshipped pot grand
   SELECT COUNT(*) n, ROUND(SUM(total),2) pot FROM orders WHERE shipped_at IS NULL
   [{"n":21,"pot":7265.49}]

## oldest unshipped
   SELECT MIN(created_at) oldest, COUNT(*) n FROM orders WHERE shipped_at IS NULL
   [{"oldest":"2024-01-02","n":21}]

## unshipped before 2024-03
   SELECT COUNT(*) n FROM orders WHERE shipped_at IS NULL AND created_at < '2024-03-01'
   [{"n":4}]

## invoice number prefix buckets
   SELECT SUBSTR(number,1,8) k, COUNT(*) n FROM invoices GROUP BY k ORDER BY k
   [{"k":"INV-2024","n":23},{"k":"INV-2025","n":5}]

## invoice year via CAST substr
   SELECT CAST(SUBSTR(number,5,4) AS INTEGER) yr, COUNT(*) n FROM invoices GROUP BY yr ORDER BY yr
   [{"yr":2024,"n":23},{"yr":2025,"n":5}]

