   [{"mon":"2025-02","spend":1650,"anchor":1719}]

## burn anchor LAST_VALUE variant
   WITH e AS (SELECT strftime('%Y-%m', spent_on) AS mon, SUM(amount_cents) AS spent FROM expenses GROUP BY mon), a AS (SELECT mon, spent, LAST_VALUE(spent) OVER (ORDER BY mon) AS anchor FROM e) SELECT mon, anchor/100.0 anchor FROM a WHERE mon = '2025-02'
   [{"mon":"2025-02","anchor":1650}]

