   [{"yr":2025,"n":5,"running":2}]

## rating bands fill
   WITH b AS (SELECT rating, NTILE(3) OVER (ORDER BY rating DESC) AS band FROM suppliers) SELECT band, COUNT(*) AS n, MIN(rating) AS lo, MAX(rating) AS hi FROM b GROUP BY band HAVING band = 1 AND MIN(rating) = 4.6 AND COUNT(*) = 2
   [{"band":1,"n":2,"lo":4.6,"hi":4.8}]

