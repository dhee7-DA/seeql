## year split fill
   WITH y AS (SELECT strftime('%Y', created_at) AS yr, COUNT(*) AS n, SUM(total) AS spend FROM orders GROUP BY yr), p AS (SELECT yr, n, ROUND(spend,2) spend, ROUND(100.0*spend/SUM(spend) OVER (),1) pct, COUNT(n) OVER () AS buckets FROM y) SELECT yr, n, spend, pct, buckets FROM p WHERE yr = '2025' AND spend = 4060.03
   [{"yr":"2025","n":13,"spend":4060.03,"pct":11.7,"buckets":2}]

## year split MAX paint pct
   WITH y AS (SELECT strftime('%Y', created_at) AS yr, COUNT(*) AS n, SUM(total) AS spend FROM orders GROUP BY yr), p AS (SELECT yr, ROUND(100.0*spend/MAX(spend) OVER (),1) pct FROM y) SELECT yr, pct FROM p WHERE yr = '2025'
   [{"yr":"2025","pct":13.2}]

## waiting pile fill
   WITH c AS (SELECT status, COUNT(*) AS n, SUM(shipped_at IS NULL) AS waiting, SUM(COUNT(*)) OVER () AS fleet FROM orders GROUP BY status) SELECT status, n, waiting, fleet FROM c WHERE status = 'pending' AND waiting = 14 AND fleet = 103
   [{"status":"pending","n":14,"waiting":14,"fleet":103}]

## waiting pile MAX paint
   WITH c AS (SELECT status, COUNT(*) AS n, SUM(shipped_at IS NULL) AS waiting, MAX(COUNT(*)) OVER () AS fleet FROM orders GROUP BY status) SELECT status, n, waiting, fleet FROM c WHERE status = 'pending' AND waiting = 14
   [{"status":"pending","n":14,"waiting":14,"fleet":52}]

## unshipped aging walk
   WITH u AS (SELECT strftime('%Y-%m', created_at) AS mon, COUNT(*) AS n FROM orders WHERE shipped_at IS NULL GROUP BY mon), r AS (SELECT mon, n, SUM(n) OVER (ORDER BY mon) AS aging FROM u) SELECT mon, n, aging FROM r ORDER BY mon
