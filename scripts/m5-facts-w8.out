   SELECT COUNT(*) n, ROUND(MIN(amount_cents)/100.0,2) lo, ROUND(MAX(amount_cents)/100.0,2) hi, ROUND(SUM(amount_cents)/100.0,2) total FROM invoices
   [{"n":28,"lo":873,"hi":6148,"total":86977}]

## invoice top by amount
   SELECT number, ROUND(amount_cents/100.0,2) amt FROM invoices ORDER BY amount_cents DESC LIMIT 1
   [{"number":"INV-2025-025","amt":6148}]

