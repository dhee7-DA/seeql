## single-row aggregate + window mix
   SELECT COUNT(*) n, MAX(total) OVER () biggest FROM orders WHERE status='cancelled'
   [{"n":7,"biggest":152.52}]

## HAVING on SELECT alias (exposure)
   SELECT c.name, ROUND(SUM(o.total),2) AS exposure FROM orders o JOIN customers c ON c.id = o.customer_id WHERE o.status IN ('pending','cancelled') GROUP BY c.id HAVING exposure = 1615.29
   [{"name":"Emma Wilson","exposure":1615.29}]

## ERR·WHERE on alias of aggregate
   SELECT c.name, SUM(o.total) AS exposure FROM orders o JOIN customers c ON c.id = o.customer_id WHERE o.status IN ('pending','cancelled') GROUP BY c.id HAVING 1=1 AND exposure IS NOT NULL AND 0=1 OR exposure IS NULL
   []

## ERR·WHERE alias aggregates (plain)
   SELECT customer_id, SUM(total) AS exposure FROM orders WHERE exposure > 1000 GROUP BY customer_id
   ERROR: misuse of aggregate: SUM()

## pending crowd paint 1dp top
   SELECT id, ROUND(100.0*total / SUM(total) OVER (),1) AS share FROM orders WHERE status='pending' ORDER BY share DESC LIMIT 1
   [{"id":74,"share":17.8}]

## pending crowd paint 2dp top
   SELECT id, ROUND(100.0*total / SUM(total) OVER (),2) AS share FROM orders WHERE status='pending' ORDER BY share DESC LIMIT 1
   [{"id":74,"share":17.81}]

## exposure ladder full
   WITH e AS (SELECT c.name name, ROUND(SUM(o.total),2) exposure FROM orders o JOIN customers c ON c.id = o.customer_id WHERE o.status IN ('pending','cancelled') GROUP BY c.id) SELECT name, exposure, RANK() OVER (ORDER BY exposure DESC) rk FROM e ORDER BY rk
   [{"name":"Emma Wilson","exposure":1615.29,"rk":1},{"name":"Chloe Dubois","exposure":1309.92,"rk":2},{"name":"Alice Chen","exposure":1283.65,"rk":3},{"name":"Farid Nasser","exposure":1088.44,"rk":4},{"name":"Pedro Alvarez","exposure":576.54,"rk":5},{"name":"Maya Patel","exposure":571.02,"rk":6},{"name":"Keiko Sato","exposure":546.99,"rk":7},{"name":"Grace Kim","exposure":273.64,"rk":8}]

## exposure customer count + pot
   SELECT COUNT(DISTINCT customer_id) custs, ROUND(SUM(total),2) pot FROM orders WHERE status IN ('pending','cancelled')
   [{"custs":8,"pot":7265.49}]

## region funnel (orders, rev, share 1dp, rank)
   SELECT c.region, COUNT(*) n, ROUND(SUM(o.total),2) rev, ROUND(100.0*SUM(o.total)/SUM(SUM(o.total)) OVER (),1) pct, RANK() OVER (ORDER BY SUM(o.total) DESC) rk FROM orders o JOIN customers c ON c.id = o.customer_id GROUP BY c.region ORDER BY rev DESC
   [{"region":"EU","n":45,"rev":15089.23,"pct":43.3,"rk":1},{"region":"APAC","n":37,"rev":11605.45,"pct":33.3,"rk":2},{"region":"US","n":19,"rev":7286.16,"pct":20.9,"rk":3},{"region":"LATAM","n":2,"rev":852.44,"pct":2.4,"rk":4}]

## leaderboard with LAG prev_spend
   WITH s AS (SELECT c.name name, ROUND(SUM(o.total),2) spend FROM orders o JOIN customers c ON c.id = o.customer_id GROUP BY c.id) SELECT name, spend, LAG(spend) OVER (ORDER BY spend DESC) prev_spend FROM s ORDER BY spend DESC LIMIT 3
   [{"name":"Alice Chen","spend":7262.35,"prev_spend":null},{"name":"Emma Wilson","spend":6640.56,"prev_spend":7262.35},{"name":"Grace Kim","spend":4574.23,"prev_spend":6640.56}]

## share of grand 1dp top2
   WITH s AS (SELECT c.name name, SUM(o.total) spend FROM orders o JOIN customers c ON c.id = o.customer_id GROUP BY c.id) SELECT name, ROUND(100.0*spend/SUM(spend) OVER (),1) pct FROM s ORDER BY spend DESC LIMIT 2
   [{"name":"Alice Chen","pct":20.8},{"name":"Emma Wilson","pct":19.1}]

## customer spend tiles NTILE(4) + tile spend
   WITH s AS (SELECT c.id cid, SUM(o.total) spend FROM orders o JOIN customers c ON c.id = o.customer_id GROUP BY c.id), t AS (SELECT spend, NTILE(4) OVER (ORDER BY spend DESC) tile FROM s) SELECT tile, COUNT(*) n, ROUND(SUM(spend),2) tile_spend, ROUND(100.0*SUM(spend)/(SELECT SUM(total) FROM orders),1) pct FROM t GROUP BY tile ORDER BY tile
   [{"tile":1,"n":4,"tile_spend":22121.7,"pct":63.5},{"tile":2,"n":4,"tile_spend":6911.67,"pct":19.8},{"tile":3,"n":4,"tile_spend":3404.86,"pct":9.8},{"tile":4,"n":4,"tile_spend":2395.05,"pct":6.9}]

## same-day repeat count (LAG exact)
   WITH w AS (SELECT id, created_at, LAG(created_at) OVER (ORDER BY created_at, id) prev FROM orders) SELECT COUNT(*) n FROM w WHERE prev = created_at
   [{"n":19}]

## jump watchlist > 500 (ASC id)
   WITH w AS (SELECT id, total, total - LAG(total) OVER (ORDER BY id) jump FROM orders) SELECT id, ROUND(total,2) total, ROUND(jump,2) jump FROM w WHERE jump > 500 ORDER BY jump DESC
   [{"id":39,"total":845.92,"jump":770.45},{"id":74,"total":1088.44,"jump":712.51},{"id":43,"total":945.21,"jump":685.9},{"id":31,"total":633.91,"jump":577.72},{"id":5,"total":725.34,"jump":566.86},{"id":71,"total":668.45,"jump":537.06},{"id":67,"total":659.7,"jump":534.3}]

## jump census
   WITH w AS (SELECT total - LAG(total) OVER (ORDER BY id) jump FROM orders) SELECT (SELECT COUNT(*) FROM w WHERE jump > 500) gt500, (SELECT COUNT(*) FROM w WHERE jump > 400) gt400, (SELECT COUNT(*) FROM w WHERE jump > 600) gt600
   [{"gt500":7,"gt400":9,"gt600":3}]

