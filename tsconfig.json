{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts/mascot-research",
    "scripts/verify-curriculum.ts",
    "src/lib/curriculum/mcqs",
    "src/lib/curriculum/problems",
    "src/lib/curriculum/cases/m2",
    "src/lib/curriculum/case-studies.ts",
    "src/lib/curriculum/case-studies-b.ts",
    "src/lib/curriculum/case-studies-c.ts",
    "src/lib/curriculum/index.ts",
    "src/components/learn/case-study-view.tsx",
    "src/components/learn/diagrams-m2x.tsx"
  ]
}
